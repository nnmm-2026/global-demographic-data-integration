# -----------------------------
# Import required libraries
# -----------------------------
import pandas as pd
import requests
import sqlite3
import matplotlib.pyplot as plt
from io import StringIO
import urllib3

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# ============================================================
# STEP 1: LOAD AND CLEAN FLAT FILE DATA
# Description:
# This step reloads the flat file source and applies the main
# cleaning steps so df_flat exists for merging.
# ============================================================

csv_url = "https://ourworldindata.org/grapher/life-expectancy-unwpp.csv?v=1&csvType=full&useColumnShortNames=false"

headers = {
    "User-Agent": "Mozilla/5.0",
    "Accept-Language": "en-US,en;q=0.9"
}

response_flat = requests.get(csv_url, headers=headers, verify=False, timeout=30)
response_flat.raise_for_status()

df_flat = pd.read_csv(StringIO(response_flat.text))

# Rename columns
df_flat = df_flat.rename(columns={
    "Entity": "Country",
    "Code": "Country_Code",
    "Year": "Year"
})

# Detect life expectancy column automatically
life_col = None
for col in df_flat.columns:
    if "life expectancy" in col.lower():
        life_col = col
        break

if life_col is not None:
    df_flat = df_flat.rename(columns={life_col: "Life_Expectancy"})

# Remove non-country rows
df_flat = df_flat[df_flat["Country_Code"].notna()]

# Remove duplicates
df_flat = df_flat.drop_duplicates()

# Remove missing critical rows
df_flat = df_flat.dropna(subset=["Country", "Year", "Life_Expectancy"])

# Format
df_flat["Country"] = df_flat["Country"].astype(str).str.strip()
df_flat["Country_Code"] = df_flat["Country_Code"].astype(str).str.strip()
df_flat["Life_Expectancy"] = pd.to_numeric(df_flat["Life_Expectancy"], errors="coerce").round(2)
df_flat = df_flat.sort_values(by=["Country", "Year"]).reset_index(drop=True)

print("Flat file loaded and cleaned:", df_flat.shape)

# ============================================================
# STEP 2: LOAD AND CLEAN WEBSITE DATA
# Description:
# This step reloads the website HTML table and applies the main
# cleaning steps so df_web exists for merging.
# ============================================================

web_url = "https://en.wikipedia.org/wiki/List_of_countries_and_dependencies_by_population"

response_web = requests.get(web_url, headers=headers, verify=False, timeout=30)
response_web.raise_for_status()

tables = pd.read_html(StringIO(response_web.text))
df_web = tables[0]

# Flatten columns if needed
if isinstance(df_web.columns, pd.MultiIndex):
    df_web.columns = [' '.join([str(i) for i in col if str(i) != 'nan']).strip() for col in df_web.columns]

df_web.columns = [str(col).strip().replace("\xa0", " ") for col in df_web.columns]

# Detect likely columns
country_col = None
population_col = None
date_col = None
source_col = None

for col in df_web.columns:
    col_lower = col.lower()
    if country_col is None and ("country" in col_lower or "dependency" in col_lower or "location" in col_lower):
        country_col = col
    if population_col is None and ("population" in col_lower) and ("%" not in col_lower) and ("percent" not in col_lower):
        population_col = col
    if date_col is None and "date" in col_lower:
        date_col = col
    if source_col is None and "source" in col_lower:
        source_col = col

rename_map = {}
if country_col is not None:
    rename_map[country_col] = "Country"
if population_col is not None:
    rename_map[population_col] = "Population"
if date_col is not None:
    rename_map[date_col] = "Date"
if source_col is not None:
    rename_map[source_col] = "Source"

df_web = df_web.rename(columns=rename_map)

# Fallbacks
if "Country" not in df_web.columns:
    df_web = df_web.rename(columns={df_web.columns[0]: "Country"})
if "Population" not in df_web.columns and len(df_web.columns) > 1:
    df_web = df_web.rename(columns={df_web.columns[1]: "Population"})

# Clean country names
df_web["Country"] = (
    df_web["Country"]
    .astype(str)
    .str.replace(r"\[.*?\]", "", regex=True)
    .str.replace(r"\(.*?\)", "", regex=True)
    .str.strip()
)

# Clean population
df_web["Population"] = (
    df_web["Population"]
    .astype(str)
    .str.replace(",", "", regex=False)
    .str.replace(r"[^0-9]", "", regex=True)
)
df_web["Population"] = pd.to_numeric(df_web["Population"], errors="coerce")

# Remove missing rows and duplicates
df_web = df_web.dropna(subset=["Country", "Population"])
df_web = df_web.drop_duplicates()

# Format
df_web["Country"] = df_web["Country"].astype(str).str.strip()
df_web = df_web.sort_values(by="Population", ascending=False).reset_index(drop=True)

print("Website data loaded and cleaned:", df_web.shape)

# ============================================================
# STEP 3: LOAD AND CLEAN API DATA
# Description:
# This step reloads the API JSON and applies the main cleaning
# steps so df_api exists for merging.
# ============================================================

api_url = "https://restcountries.com/v3.1/all?fields=name,cca3,capital,region,subregion,population,area"

response_api = requests.get(api_url, headers=headers, verify=False, timeout=30)
response_api.raise_for_status()

data = response_api.json()
df_api = pd.json_normalize(data)

# Rename columns
df_api = df_api.rename(columns={
    "name.common": "Country",
    "cca3": "Country_Code",
    "capital": "Capital",
    "region": "Region",
    "subregion": "Subregion",
    "population": "Population",
    "area": "Area"
})

# Format list capital values
if "Capital" in df_api.columns:
    df_api["Capital"] = df_api["Capital"].apply(
        lambda x: ", ".join(x) if isinstance(x, list) else x
    )

# Remove missing critical rows
df_api = df_api.dropna(subset=["Country", "Country_Code", "Population"])

# Remove duplicates
df_api = df_api.drop_duplicates()

# Clean text
for col in ["Country", "Country_Code", "Capital", "Region", "Subregion"]:
    if col in df_api.columns:
        df_api[col] = df_api[col].astype(str).str.strip()

# Format numerics
df_api["Population"] = pd.to_numeric(df_api["Population"], errors="coerce")
df_api["Area"] = pd.to_numeric(df_api["Area"], errors="coerce").round(2)

df_api = df_api.sort_values(by="Population", ascending=False).reset_index(drop=True)

print("API data loaded and cleaned:", df_api.shape)

# ============================================================
# STEP 4: PREVIEW CLEANED DATAFRAMES
# ============================================================

print("\n============================================================")
print("STEP 4: PREVIEW CLEANED DATAFRAMES")
print("============================================================")
print("Flat file shape:", df_flat.shape)
print("Website shape:", df_web.shape)
print("API shape:", df_api.shape)

# ============================================================
# STEP 5: CONNECT TO SQLITE DATABASE
# ============================================================

conn = sqlite3.connect("term_project.db")

print("Connected to SQLite database successfully.")

# ============================================================
# STEP 6: LOAD EACH CLEANED DATASET INTO SQLITE
# ============================================================

df_flat.to_sql("life_expectancy", conn, if_exists="replace", index=False)
df_web.to_sql("population_web", conn, if_exists="replace", index=False)
df_api.to_sql("country_api", conn, if_exists="replace", index=False)

print("\nTables loaded into SQLite:")
tables = pd.read_sql_query("SELECT name FROM sqlite_master WHERE type='table';", conn)
print(tables)

# ============================================================
# STEP 7: MERGE DATASETS USING SQL JOINS
# ============================================================

merge_query = """
SELECT
    le.Country AS Country,
    le.Country_Code AS Country_Code,
    le.Year AS Year,
    le.Life_Expectancy AS Life_Expectancy,
    pw.Population AS Web_Population,
    pw.Date AS Population_Date,
    pw.Source AS Population_Source,
    ca.Capital AS Capital,
    ca.Region AS Region,
    ca.Subregion AS Subregion,
    ca.Population AS API_Population,
    ca.Area AS Area
FROM life_expectancy le
LEFT JOIN country_api ca
    ON le.Country_Code = ca.Country_Code
LEFT JOIN population_web pw
    ON le.Country = pw.Country
"""

df_merged = pd.read_sql_query(merge_query, conn)
df_merged.to_sql("merged_country_data", conn, if_exists="replace", index=False)

print("\n============================================================")
print("STEP 7: MERGED DATASET PREVIEW")
print("============================================================")
print(df_merged.head())
print("\nMerged dataset shape:", df_merged.shape)

# ============================================================
# STEP 8: FINAL HUMAN-READABLE MERGED DATASET
# ============================================================

print("\n============================================================")
print("FINAL HUMAN-READABLE MERGED DATASET")
print("============================================================")
print(df_merged.head(50))
print("\nFinal Shape:", df_merged.shape)

# ============================================================
# STEP 9: VISUALIZATION 1
# ============================================================

latest_year = df_merged["Year"].max()

viz1 = df_merged[df_merged["Year"] == latest_year][["Country", "Life_Expectancy"]].dropna()
viz1 = viz1.drop_duplicates(subset=["Country"])
viz1 = viz1.sort_values(by="Life_Expectancy", ascending=False).head(10)

plt.figure(figsize=(10, 6))
plt.bar(viz1["Country"], viz1["Life_Expectancy"])
plt.xticks(rotation=45, ha="right")
plt.title("Visualization 1: Top 10 Countries by Life Expectancy")
plt.xlabel("Country")
plt.ylabel("Life Expectancy")
plt.tight_layout()
plt.show()

# ============================================================
# STEP 10: VISUALIZATION 2
# ============================================================

viz2 = df_merged[["Country", "Web_Population"]].dropna().drop_duplicates()
viz2 = viz2.sort_values(by="Web_Population", ascending=False).head(10)

plt.figure(figsize=(10, 6))
plt.bar(viz2["Country"], viz2["Web_Population"])
plt.xticks(rotation=45, ha="right")
plt.title("Visualization 2: Top 10 Countries by Website Population")
plt.xlabel("Country")
plt.ylabel("Population")
plt.tight_layout()
plt.show()

# ============================================================
# STEP 11: VISUALIZATION 3
# ============================================================

viz3 = df_merged[df_merged["Year"] == latest_year][["Region", "Life_Expectancy"]].dropna()
viz3 = viz3.groupby("Region", as_index=False)["Life_Expectancy"].mean()

plt.figure(figsize=(10, 6))
plt.bar(viz3["Region"], viz3["Life_Expectancy"])
plt.xticks(rotation=45, ha="right")
plt.title("Visualization 3: Average Life Expectancy by Region")
plt.xlabel("Region")
plt.ylabel("Average Life Expectancy")
plt.tight_layout()
plt.show()

# ============================================================
# STEP 12: VISUALIZATION 4
# ============================================================

viz4 = df_merged[df_merged["Year"] == latest_year][["Country", "Life_Expectancy", "Web_Population"]].dropna()
viz4 = viz4.drop_duplicates(subset=["Country"])

plt.figure(figsize=(10, 6))
plt.scatter(viz4["Web_Population"], viz4["Life_Expectancy"])
plt.title("Visualization 4: Population vs Life Expectancy")
plt.xlabel("Population")
plt.ylabel("Life Expectancy")
plt.tight_layout()
plt.show()

# ============================================================
# STEP 13: VISUALIZATION 5
# ============================================================

viz5 = df_merged[["Country", "Area"]].dropna().drop_duplicates()
viz5 = viz5.sort_values(by="Area", ascending=False).head(10)

plt.figure(figsize=(10, 6))
plt.bar(viz5["Country"], viz5["Area"])
plt.xticks(rotation=45, ha="right")
plt.title("Visualization 5: Top 10 Countries by Area")
plt.xlabel("Country")
plt.ylabel("Area")
plt.tight_layout()
plt.show()

# ============================================================
# STEP 14: CLOSE DATABASE CONNECTION
# ============================================================

conn.close()
print("Database connection closed.")
